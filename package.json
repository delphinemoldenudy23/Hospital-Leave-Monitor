{
  "name": "hospital-leave-monitor",
  "version": "2.0.0",
  "description": "Hospital Leave Management System - Unified Web, Desktop & PWA",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "export": "next export",
    "electron:dev": "concurrently \"next dev\" \"wait-on http://localhost:3000 && npx electron electron/main.js\"",
    "electron:build": "next build && npx electron-builder",
    "tauri:dev": "npm run dev & npx tauri dev",
    "backend:install": "cd Backend && npm install",
    "backend:dev": "cd Backend && npm run dev",
    "backend:start": "cd Backend && npm start",
    "dev:all": "concurrently \"npm run backend:dev\" \"npm run dev\"",
    "icons": "node scripts/generate-icons.js"
  },
  "dependencies": {
    "axios": "^1.5.0",
    "date-fns": "^2.30.0",
    "lucide-react": "^0.263.1",
    "next": "^14.0.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-hot-toast": "^2.4.1",
    "recharts": "^2.10.0",
    "socket.io-client": "^4.6.1",
    "zustand": "^4.4.1"
  },
  "devDependencies": {
    "@types/node": "^20.8.0",
    "@types/react": "^18.2.31",
    "autoprefixer": "^10.4.16",
    "concurrently": "^8.2.2",
    "eslint": "^8.50.0",
    "eslint-config-next": "^14.0.0",
    "postcss": "^8.4.31",
    "tailwindcss": "^3.3.5",
    "typescript": "^5.2.2",
    "wait-on": "^7.0.1"
  }
}